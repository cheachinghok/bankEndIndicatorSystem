# Copy to .env and fill in real values. Never commit .env.

# OANDA v20 API
# Sign up: https://www.oanda.com/apply/ (choose "Practice" for demo)
# Generate token: https://www.oanda.com/demo-account/tpa/personal_token
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice  # practice | live
OANDA_API_URL=https://api-fxpractice.oanda.com  # https://api-fxtrade.oanda.com for live

# Postgres (matches docker-compose service)
DATABASE_URL=postgresql+asyncpg://gold:gold@localhost:5432/gold_signals

# Redis
REDIS_URL=redis://localhost:6379/0

# App
LOG_LEVEL=INFO
